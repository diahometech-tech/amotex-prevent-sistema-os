# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NexusFlow — dados locais (nunca subir para o repo)
/src/lib/local_db.json
/public/uploads/
/dossies/

# chaves SSH / credenciais (nunca subir para o repo)
*.ppk
*.key
*.pem
id_rsa*
.ssh/

# skills de teste de segurança (Strix, instaladas via `npx skills add`) —
# ferramenta local, não faz parte do app; não sobe pro repo compartilhado
/.agents/
/skills-lock.json
/.claude/skills/api-security-testing/
/.claude/skills/application-security-testing/
/.claude/skills/ci-security-scanning-with-strix/
/.claude/skills/find-security-vulnerabilities-in-code/
/.claude/skills/fix-security-vulnerabilities-with-strix/
/.claude/skills/managed-pentesting-with-strix/
/.claude/skills/owasp-top-10-testing/
/.claude/skills/penetration-testing-with-strix/
/.claude/skills/web-app-penetration-testing/
